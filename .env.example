# ===== שרת =====
NODE_ENV=development
PORT=4000
# כתובות הלקוח (React) המורשות ב-CORS, מופרדות בפסיק
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# מספר ה-proxies שלפני השרת (0 בפיתוח מקומי)
TRUST_PROXY=0

# ===== מסד נתונים =====
DATABASE_URL=postgresql://wardrobe:wardrobe@localhost:5432/wardrobe?schema=public

# ===== סודות =====
# מחרוזת אקראית של 32 תווים לפחות. ליצירה: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
CODE_PEPPER=replace-with-a-long-random-secret-of-at-least-32-chars

# ===== התחברות =====
SESSION_TTL_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_MAX=50
BCRYPT_ROUNDS=12
